rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ===================== Helpers =====================

    function isSignedIn() { return request.auth != null; }

    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() { return myData().role; }
    function mySchoolId() { return myData().schoolId; }
    function mySectionId() { return myData().sectionId; }

    function isAdmin() { return isSignedIn() && myRole() == 'admin'; }
    function isInstructor() { return isSignedIn() && myRole() == 'instructor'; }
    function isStudent() { return isSignedIn() && myRole() == 'student'; }
    function isParent() { return isSignedIn() && myRole() == 'parent'; }

    // بوابة العزل بين المدارس: أي وثيقة عندها schoolId لازم تطابق مدرسة المستخدم الحالي
    function sameSchool(schoolId) { return isSignedIn() && mySchoolId() == schoolId; }

    // صاحب المنصة (super-admin) — منفصل تمامًا عن نموذج users/schoolId، ما بينشأ إلا بسكربت Admin SDK.
    // وصول تقني كامل (قراءة فقط) للمجموعات الأكاديمية الأساسية بغرض الدعم الفني — الالتزام بتسجيل
    // السبب بـ auditLog قبل أي وصول فعلي مسؤولية طبقة الواجهة (UI)، مش شي القواعد نفسها قادرة تفرضه
    // تقنيًا (Firestore rules ما بتقدر تتحقق من "انكتب سجل قبل هالقراءة" بشكل موثوق وقت التنفيذ).
    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // السنة الدراسية الحالية لمدرسة الكاتب — تُستخدم لمنع الكتابة بسنة مقفولة/غير نشطة
    function currentYear() {
      return get(/databases/$(database)/documents/schools/$(mySchoolId())).data.currentAcademicYear;
    }

    function isParentOf(uid) {
      return isParent() && myData().childUids.hasAny([uid]);
    }

    function subjectData(subjectId) {
      return get(/databases/$(database)/documents/subjects/$(subjectId)).data;
    }

    // لازم يكون معلّم المادة فعلاً وبنفس مدرسته (دفاع إضافي حتى لو كان teacherUid متطابق بالغلط)
    function teachesSubject(subjectId) {
      return isInstructor() && subjectData(subjectId).teacherUid == request.auth.uid
        && subjectData(subjectId).schoolId == mySchoolId();
    }

    // بالنسبة للمادة: يقدر يشوفها المعلّم يلي بيدرّسها، أو الإدارة، أو أي حدا بنفس شعبة المادة
    function inSectionOfSubject(subjectId) {
      return isSignedIn() && mySectionId() == subjectData(subjectId).sectionId;
    }

    // هل قسم/شعبة الطالب (studentUid) نفس الشعبة المعطاة
    function studentInSection(studentUid, sectionId) {
      return get(/databases/$(database)/documents/users/$(studentUid)).data.sectionId == sectionId;
    }

    // شعب المعلّم يلي فعلاً بيدرّسها (محفوظة على وثيقة المعلّم نفسه، ومحدثة فقط من addSubject
    // يلي هي عملية إدارة حصراً - admin). هاد بديل عن استعلام "where" غير المتاح جوا القواعد
    function myTaughtSectionIds() {
      return isInstructor() && ('taughtSectionIds' in myData()) ? myData().taughtSectionIds : [];
    }

    // هل المعلّم فعلاً بيدرّس هالمادة، وكمان الطالب studentUid بشعبة هالمادة
    // (بيستبدل الاعتماد القديم على isInstructor() المجردة بربط حقيقي بين المعلّم والطالب)
    function teachesStudentInSubject(subjectId, studentUid) {
      return teachesSubject(subjectId) && studentInSection(studentUid, subjectData(subjectId).sectionId);
    }

    // ===================== schools =====================
    // وثيقة كل مدرسة (tenant). ما في تسجيل ذاتي — مدرسة جديدة بتنعمل بس عن طريق سكربت
    // الإدارة (scripts/create-school.mjs) يلي بيستخدم صلاحيات admin SDK وبيتخطى هاي القواعد أصلاً.
    match /schools/{schoolId} {
      allow read: if isSignedIn() && mySchoolId() == schoolId;
      // الحقول يلي الإدارة تقدر تعدّلها من المتصفح — السنة الدراسية، فيتشر فلاغز، دوام رمضان، العملة
      allow update: if isAdmin() && sameSchool(schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentAcademicYear', 'features', 'ramadanSchedule', 'currency', 'paymentInfo', 'branding'])
        && (!('currentAcademicYear' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.currentAcademicYear is string)
        && (!('features' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.features is map)
        && (!('ramadanSchedule' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.ramadanSchedule is map)
        && (!('currency' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.currency is string)
        && (!('paymentInfo' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.paymentInfo is map)
        && (!('branding' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.branding is map);
      // صاحب المنصة يقدر يعدّل حقل branding بس لأي مدرسة (مش بقية الحقول)
      allow update: if isPlatformAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branding'])
        && request.resource.data.branding is map;
      allow create, delete: if false;
    }

    // ===================== users =====================
    // ملاحظة مهمة (تأكدنا منها بتجارب REST فعلية مباشرة على الإنتاج): قواعد LIST/QUERY (مش GET
    // مفرد لوثيقة وحدة) عند Firestore بترفض أي شرط يعتمد على "let" لتجميع نتيجة get()، أو استخدام
    // "in" على مصفوفة جاية من get() ديناميكي — كلاهما يرجّع permission-denied بصمت رغم إنه GET
    // المفرد لنفس الوثيقة بنفس الرول ينجح 100%. الحل: نداءات get() inline مباشرة (بدون let)،
    // وبدون "in" على مصفوفة ديناميكية. لهيك شرط المعلّم تحت خفّينا فيه التحقق الدقيق بالشعبة —
    // القراءة هون اسم/دور بس (منخفضة الحساسية)، والكتابة الحساسة الفعلية (علامات/حضور) محمية بشرط
    // أدق (teachesStudentInSubject) بقواعد marks/attendance/homework.
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isParentOf(uid)
        || (isAdmin() && sameSchool(resource.data.schoolId))
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor' && resource.data.role == 'student')
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor' && resource.data.role == 'parent')
        || isPlatformAdmin()
      );
      // ما في تسجيل ذاتي ولا إنشاء حساب "admin" من المتصفح إطلاقًا — أول حساب إدارة لأي مدرسة
      // بينعمل بس عن طريق سكربت الإدارة (admin SDK، بيتخطى هاي القواعد). من هون، admin موجود
      // فقط يقدر يدعو حسابات جديدة (معلّم/طالب/ولي أمر) داخل مدرسته هو.
      allow create: if isAdmin()
        && mySchoolId() == request.resource.data.schoolId
        && request.resource.data.role in ['student', 'instructor', 'parent']
        && request.resource.data.keys().hasAll(['name', 'role', 'email', 'schoolId']);
      // المستخدم يقدر يعدّل بس اسمه وصورته الرمزية بحسابه هو (تخصيص البروفايل)، وممنوع يلمس
      // أي حقل حساس متل role أو sectionId أو childUids أو schoolId عن هالطريق
      allow update: if (
        isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId
      ) || (
        isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarId', 'consentGivenAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
      );
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ===================== grades / sections =====================
    match /grades/{id} {
      allow read: if isSignedIn() && (sameSchool(resource.data.schoolId) || isPlatformAdmin());
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId();
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }
    // ===================== timetables =====================
    // وثيقة وحدة لكل شعبة (docId = sectionId)، فيها slots[] {day, period, subjectId}
    match /timetables/{sectionId} {
      // resource == null لو الشعبة ما إلها جدول محفوظ بعد — بدونها كل قراءة أول مرة كانت
      // ترجع permission-denied بدل "غير موجود" (Firestore rules gotcha عند get على وثيقة مش موجودة)
      allow read: if isSignedIn() && (resource == null || sameSchool(resource.data.schoolId) || isPlatformAdmin());
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId() && request.resource.data.sectionId == sectionId;
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    match /sections/{id} {
      allow read: if isSignedIn() && (sameSchool(resource.data.schoolId) || isPlatformAdmin());
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId();
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ===================== subjects =====================
    match /subjects/{id} {
      allow read: if isSignedIn() && (sameSchool(resource.data.schoolId) || isPlatformAdmin());
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear();
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
      allow update: if (isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId) || (
        teachesSubject(id)
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.sectionId == resource.data.sectionId
        && request.resource.data.schoolId == resource.data.schoolId
      );
    }

    // ===================== progress =====================
    match /progress/{docId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isParentOf(resource.data.uid)
        || teachesSubject(resource.data.subjectId)
        || (isAdmin() && sameSchool(resource.data.schoolId))
        || isPlatformAdmin()
      );
      // حدّينا completedLessons بحد أعلى معقول حتى ما يقدر الطالب يزوّر رقم عشوائي كبير
      allow create, update: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear()
        && request.resource.data.keys().hasAll(['uid', 'subjectId', 'completedLessons', 'schoolId'])
        && request.resource.data.completedLessons is int
        && request.resource.data.completedLessons >= 0
        && request.resource.data.completedLessons <= 10000
        // بالتحديث: ما يقدر يرجّع الرقم للخلف (يمنع تصفير التقدم قصداً وإعادة تسجيله لاحقاً بشكل ملتبس)
        && (!exists(/databases/$(database)/documents/progress/$(docId)) || request.resource.data.completedLessons >= resource.data.completedLessons);
      allow delete: if false;
    }

    // ===================== homework =====================
    match /homework/{hwId} {
      allow read: if isSignedIn() && (sameSchool(resource.data.schoolId) || isPlatformAdmin());
      allow create: if teachesSubject(request.resource.data.courseId)
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear()
        && request.resource.data.keys().hasAll(['courseId', 'title', 'deadline', 'schoolId']);
      allow update, delete: if false;
    }

    // ===================== submissions =====================
    match /submissions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || isParentOf(resource.data.studentUid)
        || teachesSubject(get(/databases/$(database)/documents/homework/$(resource.data.homeworkId)).data.courseId)
        || (isAdmin() && sameSchool(resource.data.schoolId))
        || isPlatformAdmin()
      );
      allow create: if isStudent() && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear();
      // دورة الحالة: submitted -> (returned <-> resubmitted)* -> graded. الطالب بس يقدر يعيد
      // التسليم بعد ما المعلّم يرجّعها له صراحة (status == 'returned')، مش أي وقت قبل التصحيح —
      // هيك ما بيقدر يبدّل جوابه بعد ما المعلّم بلّشه يصحح أو بعده مصحّح أصلًا.
      allow update: if isSignedIn() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (
        (isStudent() && resource.data.studentUid == request.auth.uid && request.resource.data.studentUid == request.auth.uid
          && resource.data.status == 'returned' && request.resource.data.status == 'resubmitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['url', 'submittedAt', 'status', 'attemptCount', 'timeline']))
        || (teachesSubject(get(/databases/$(database)/documents/homework/$(resource.data.homeworkId)).data.courseId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'teacherComment', 'gradedAt', 'timeline'])
          && request.resource.data.status in ['returned', 'graded'])
      );
      allow delete: if false;
    }

    // ===================== quizStats =====================
    match /quizStats/{statId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isParentOf(resource.data.uid)
        || teachesSubject(resource.data.subjectId)
        || (isAdmin() && sameSchool(resource.data.schoolId))
        || isPlatformAdmin()
      );
      // ملاحظة: الحقول الفعلية يلي recordAttempt() ببعتها هي attempts/correct (increment)،
      // مش score/maxScore — القاعدة كانت ناقصة/غلط وكل محاولة اختبار كانت مرفوضة صامتًا قبل هالتصحيح
      allow create, update: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear()
        && request.resource.data.keys().hasAll(['uid', 'subjectId', 'attempts', 'correct', 'schoolId'])
        && request.resource.data.attempts is int
        && request.resource.data.correct is int
        && request.resource.data.attempts >= 0
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.attempts;
      allow delete: if false;
    }

    // ===================== notifications =====================
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn() && (
        (request.resource.data.recipientUid == request.auth.uid)
        || (
          (isInstructor() || isAdmin())
          && request.resource.data.keys().hasAll(['recipientUid', 'message', 'type', 'schoolId'])
          && request.resource.data.type in ['info', 'grade', 'homework', 'attendance', 'warning', 'feedback']
          && request.resource.data.schoolId == mySchoolId()
          && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.schoolId == mySchoolId()
        )
      );
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ===================== notes =====================
    match /notes/{noteId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId);
      allow create, update: if teachesSubject(request.resource.data.courseId)
        && request.resource.data.instructorUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear();
      allow delete: if false;
    }

    // ===================== questions =====================
    match /questions/{qId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || teachesSubject(resource.data.subjectId)
        || (isAdmin() && sameSchool(resource.data.schoolId))
      );
      allow create: if isStudent() && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear();
      allow update: if teachesSubject(resource.data.subjectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt']);
      allow delete: if false;
    }

    // ===================== marks =====================
    match /marks/{markId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || isParentOf(resource.data.studentUid)
        || resource.data.teacherUid == request.auth.uid
        || (isAdmin() && sameSchool(resource.data.schoolId))
        || isPlatformAdmin()
      );
      // لازم يكون معلّم المادة نفسها، وكمان الطالب فعلاً بشعبة هالمادة (مو أي طالب بالمدرسة)
      allow create: if teachesStudentInSubject(request.resource.data.subjectId, request.resource.data.studentUid)
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear()
        && request.resource.data.keys().hasAll(['subjectId', 'studentUid', 'categoryId', 'score', 'maxScore', 'teacherUid', 'schoolId']);
      // بالتحديث: ممنوع تغيير هوية الطالب أو المادة أو صاحب العلامة الأصلي (يمنع "سرقة"/نقل علامة طالب لطالب تاني)
      // وممنوع تعديل علامة بسنة مقفولة (مش السنة الحالية) — يحمي التاريخ من التعديل بعد الترفيع
      allow update: if teachesStudentInSubject(request.resource.data.subjectId, request.resource.data.studentUid)
        && request.resource.data.teacherUid == request.auth.uid
        && resource.data.teacherUid == request.auth.uid
        && resource.data.studentUid == request.resource.data.studentUid
        && resource.data.subjectId == request.resource.data.subjectId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.academicYear == currentYear()
        && request.resource.data.keys().hasAll(['subjectId', 'studentUid', 'categoryId', 'score', 'maxScore', 'teacherUid', 'schoolId']);
      allow delete: if false;
    }

    // ===================== threads / messages (رسائل معلّم ↔ ولي أمر) =====================

    // uid الطرف التاني بمحادثة ثنائية (participantUids دايمًا عنصرين)
    function otherParticipant(participantUids) {
      return participantUids[0] == request.auth.uid ? participantUids[1] : participantUids[0];
    }
    // الرسائل محصورة بين معلّم وولي أمر بس (مو أي دورين)، وبنفس المدرسة
    function isInstructorParentPair(otherUid) {
      return isSignedIn() && sameSchool(get(/databases/$(database)/documents/users/$(otherUid)).data.schoolId) && (
        (myRole() == 'instructor' && get(/databases/$(database)/documents/users/$(otherUid)).data.role == 'parent')
        || (myRole() == 'parent' && get(/databases/$(database)/documents/users/$(otherUid)).data.role == 'instructor')
      );
    }

    match /threads/{threadId} {
      // resource == null لو أول رسالة بين هالطرفين لسا ما انبعثت — openThreadWith() بيعمل
      // getDoc() قبل الإنشاء، وبدون هالشرط كانت ترجع permission-denied بدل "غير موجود"
      allow read: if isSignedIn() && (resource == null || resource.data.participantUids.hasAny([request.auth.uid]));
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.keys().hasAll(['participantUids', 'schoolId'])
        && isInstructorParentPair(otherParticipant(request.resource.data.participantUids));
      // تحديث معلومات آخر رسالة (بعد الإرسال) أو تعليم المحادثة كمقروءة — بدون لمس هوية الأطراف
      allow update: if isSignedIn() && resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderUid', 'readBy']);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.keys().hasAll(['threadId', 'senderUid', 'recipientUid', 'text', 'schoolId'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && isInstructorParentPair(request.resource.data.recipientUid);
      // المستلم بس يقدر يعلّم الرسالة كمقروءة، ما في تعديل نص أو حذف
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ===================== feedbackCases (الملاحظات والمتابعة) =====================
    // أربع مسارات بس: parent_to_teacher, parent_to_admin, teacher_to_parent, admin_to_parent.
    // القراءة إما للمشارك (participantUids) أو للإدارة لما تكون الحالة موجهة لها أو مصعّدة إليها.
    match /feedbackCases/{feedbackId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId) && (
        resource.data.participantUids.hasAny([request.auth.uid])
        || (isAdmin() && (resource.data.recipientRole == 'admin' || resource.data.escalatedToAdmin == true))
      );

      allow create: if isSignedIn()
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByRole == myRole()
        && request.resource.data.status == 'open'
        && request.resource.data.escalatedToAdmin == false
        && request.resource.data.readBy == [request.auth.uid]
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000
        && request.resource.data.keys().hasAll([
          'schoolId', 'route', 'createdByUid', 'createdByRole', 'recipientRole', 'kind', 'category',
          'title', 'body', 'requiresResponse', 'status', 'escalatedToAdmin', 'participantUids', 'readBy',
        ])
        && (
          // ولي أمر → معلّم مادة ابنه (ممنوع نوع complaint هون — لازم يروح للإدارة بدل المعلّم مباشرة)
          (myRole() == 'parent' && request.resource.data.route == 'parent_to_teacher'
            && request.resource.data.recipientRole == 'instructor'
            && request.resource.data.kind != 'complaint'
            && isParentOf(request.resource.data.studentUid)
            && subjectData(request.resource.data.subjectId).schoolId == mySchoolId()
            && studentInSection(request.resource.data.studentUid, subjectData(request.resource.data.subjectId).sectionId)
            && request.resource.data.recipientUid == subjectData(request.resource.data.subjectId).teacherUid
            && request.resource.data.participantUids.hasAll([request.auth.uid, request.resource.data.recipientUid])
            && request.resource.data.participantUids.size() == 2)

          // ولي أمر → الإدارة (بدون معلّم مستلم محدد؛ عام أو مرتبط بابنه)
          || (myRole() == 'parent' && request.resource.data.route == 'parent_to_admin'
            && request.resource.data.recipientRole == 'admin'
            && request.resource.data.recipientUid == null
            && (request.resource.data.studentUid == null || isParentOf(request.resource.data.studentUid))
            && request.resource.data.participantUids == [request.auth.uid])

          // معلّم → ولي أمر طالب بيدرّسه فعلاً
          || (myRole() == 'instructor' && request.resource.data.route == 'teacher_to_parent'
            && request.resource.data.recipientRole == 'parent'
            && teachesSubject(request.resource.data.subjectId)
            && studentInSection(request.resource.data.studentUid, subjectData(request.resource.data.subjectId).sectionId)
            && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.role == 'parent'
            && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.schoolId == mySchoolId()
            && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.childUids.hasAny([request.resource.data.studentUid])
            && request.resource.data.participantUids.hasAll([request.auth.uid, request.resource.data.recipientUid])
            && request.resource.data.participantUids.size() == 2)

          // الإدارة → ولي أمر بنفس المدرسة
          || (isAdmin() && request.resource.data.route == 'admin_to_parent'
            && request.resource.data.recipientRole == 'parent'
            && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.role == 'parent'
            && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.schoolId == mySchoolId()
            && (request.resource.data.studentUid == null
              || get(/databases/$(database)/documents/users/$(request.resource.data.studentUid)).data.schoolId == mySchoolId())
            && request.resource.data.participantUids.hasAll([request.auth.uid, request.resource.data.recipientUid])
            && request.resource.data.participantUids.size() == 2)
        );

      // المشارك: يعلّم كمقروء، يغيّر الحالة، يصعّد (بدون رجوع عن التصعيد)، بدون لمس هوية الأطراف أو المحتوى
      allow update: if isSignedIn() && resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readBy', 'status', 'lastReplyAt', 'lastReplyByUid', 'escalatedToAdmin', 'escalatedAt', 'resolvedAt', 'closedAt', 'updatedAt',
        ])
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed']
        && (request.resource.data.escalatedToAdmin == resource.data.escalatedToAdmin
          || (resource.data.escalatedToAdmin == false && request.resource.data.escalatedToAdmin == true))

      // الإدارة المخوّلة على الحالة: تعيين مسؤول متابعة وتغيير الحالة، بدون لمس محتوى الملاحظة
      allow update: if isAdmin() && sameSchool(resource.data.schoolId)
        && (resource.data.recipientRole == 'admin' || resource.data.escalatedToAdmin == true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedAdminUid', 'status', 'resolvedAt', 'closedAt', 'readBy', 'updatedAt'])
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed']

      allow delete: if false;
    }

    // ===================== feedbackReplies (ردود الملاحظات) =====================
    // ردود عادية (participants) تظهر للمشاركين + الإدارة المخوّلة، وملاحظات داخلية (admin_internal) للإدارة بس.
    match /feedbackReplies/{replyId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId) && (
        (isAdmin() && (
          get(/databases/$(database)/documents/feedbackCases/$(resource.data.feedbackId)).data.recipientRole == 'admin'
          || get(/databases/$(database)/documents/feedbackCases/$(resource.data.feedbackId)).data.escalatedToAdmin == true
        ))
        || (resource.data.visibility == 'participants'
          && get(/databases/$(database)/documents/feedbackCases/$(resource.data.feedbackId)).data.participantUids.hasAny([request.auth.uid]))
      );

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == myRole()
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000
        && request.resource.data.keys().hasAll(['feedbackId', 'schoolId', 'authorUid', 'authorRole', 'body', 'visibility'])
        && get(/databases/$(database)/documents/feedbackCases/$(request.resource.data.feedbackId)).data.schoolId == mySchoolId()
        && (
          (request.resource.data.visibility == 'participants' && (
            get(/databases/$(database)/documents/feedbackCases/$(request.resource.data.feedbackId)).data.participantUids.hasAny([request.auth.uid])
            || (isAdmin() && (
              get(/databases/$(database)/documents/feedbackCases/$(request.resource.data.feedbackId)).data.recipientRole == 'admin'
              || get(/databases/$(database)/documents/feedbackCases/$(request.resource.data.feedbackId)).data.escalatedToAdmin == true
            ))
          ))
          || (request.resource.data.visibility == 'admin_internal' && isAdmin() && (
            get(/databases/$(database)/documents/feedbackCases/$(request.resource.data.feedbackId)).data.recipientRole == 'admin'
            || get(/databases/$(database)/documents/feedbackCases/$(request.resource.data.feedbackId)).data.escalatedToAdmin == true
          ))
        );

      allow update, delete: if false;
    }

    // ===================== attendance =====================
    match /attendance/{attId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || isParentOf(resource.data.studentUid)
        || resource.data.teacherUid == request.auth.uid
        || (isAdmin() && sameSchool(resource.data.schoolId))
        || isPlatformAdmin()
      );
      allow create, update: if isInstructor()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.academicYear == currentYear()
        && studentInSection(request.resource.data.studentUid, request.resource.data.sectionId);
      allow delete: if isInstructor() && resource.data.teacherUid == request.auth.uid;
    }

    // ===================== auditLog (سجل تدقيق) =====================
    match /auditLog/{id} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.keys().hasAll(['schoolId', 'actorUid', 'action', 'targetType', 'createdAt']);
      allow update, delete: if false;
    }

    // ===================== announcements (إعلانات المدرسة) =====================
    match /announcements/{id} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'body', 'schoolId', 'authorUid', 'createdAt']);
      // أي حدا بنفس المدرسة يقدر يعلّم نفسه كـ"شافها" — بدون لمس أي حقل تاني
      allow update: if isSignedIn() && sameSchool(resource.data.schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if false;
    }

    // ===================== excuseRequests (طلب عذر مسبق من ولي الأمر) =====================
    match /excuseRequests/{id} {
      allow read: if isSignedIn() && (
        resource.data.requestedByUid == request.auth.uid
        || isParentOf(resource.data.studentUid)
        // القراءة (list) خفّفناها لنفس مدرسة المعلّم بس — الرول الأصلية (sectionId in myTaughtSectionIds())
        // بترجع permission-denied لأي LIST query لأنها "in" على مصفوفة جاية من get() ديناميكي؛ نفس
        // القاعدة تنجح لو get() مفرد بس. الموافقة/الرفض الفعلية لسا محمية بدقة الشعبة بقاعدة update تحت.
        || (isInstructor() && sameSchool(resource.data.schoolId))
        || (isAdmin() && sameSchool(resource.data.schoolId))
      );
      allow create: if isParent() && isParentOf(request.resource.data.studentUid)
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.status == 'pending'
        && studentInSection(request.resource.data.studentUid, request.resource.data.sectionId)
        && request.resource.data.keys().hasAll(['studentUid', 'sectionId', 'date', 'reason', 'status', 'requestedByUid', 'schoolId']);
      // المعلّم بس يقدر يوافق/يرفض، وبس على طلبات شعبه
      allow update: if isInstructor() && resource.data.sectionId in myTaughtSectionIds() && sameSchool(resource.data.schoolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedByUid'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }

    // ===================== earlyWarnings (إنذار مبكر) =====================
    // وثيقة واحدة محسوبة لكل طالب (docId = studentUid)، الإدارة بس بتكتبها (recompute من لوحة الإدارة)
    match /earlyWarnings/{studentUid} {
      allow read: if isSignedIn() && (
        request.auth.uid == studentUid
        || isParentOf(studentUid)
        || (isAdmin() && sameSchool(resource.data.schoolId))
        // نفس ملاحظة excuseRequests فوق — القراءة list محتاجة تتجنّب "in" على مصفوفة get() ديناميكية
        || (isInstructor() && sameSchool(resource.data.schoolId))
      );
      allow create, update: if isAdmin()
        && request.resource.data.studentUid == studentUid
        && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.keys().hasAll(['studentUid', 'schoolId', 'sectionId', 'updatedAt']);
      allow delete: if false;
    }

    // ===================== honorBoards (لوحات الشرف) =====================
    // نتائج محسوبة ومعروضة للجميع (أسماء ومعدلات بس، بدون علامات خام) — الإدارة بس بتكتبها
    match /honorBoards/{boardId} {
      // نفس ملاحظة timetables: resource == null لو اللوحة ما انحسبت بعد (قبل أول "تحديث الآن")
      allow read: if isSignedIn() && (resource == null || sameSchool(resource.data.schoolId));
      // boardId لازم يكون مسبوق بـ schoolId الكاتب — هيك ما في مجال مدرسة توصل تكتب على معرّف
      // ثابت/مشترك بتحتلّه مدرسة تانية (كان قبل هيك: school_top_students موحّدة لكل المدارس)
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId()
        && boardId.split('_')[0] == mySchoolId();
      allow update: if isAdmin() && resource.data.schoolId == mySchoolId()
        && request.resource.data.schoolId == resource.data.schoolId
        && boardId.split('_')[0] == mySchoolId();
      allow delete: if false;
    }

    // ===================== teacherAvailability (توفر المعلمين) =====================
    // وثيقة وحدة لكل معلم (docId = teacherUid)، فيها unavailable[] {day, period} — الإدارة بس بتعدّلها
    match /teacherAvailability/{teacherUid} {
      allow read: if isSignedIn() && (resource == null || sameSchool(resource.data.schoolId) || isPlatformAdmin());
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId() && request.resource.data.teacherUid == teacherUid;
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if false;
    }

    // ===================== teacherAbsences (غياب معلم) =====================
    // القراءة لكل مدرسة (المعلم البديل والشعبة لازم يشوفوا الغياب)، الكتابة/التعديل إدارة بس
    match /teacherAbsences/{absenceId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.createdByUid == request.auth.uid && request.resource.data.status == 'open';
      // تعديل وحيد مسموح بعد الإنشاء: تحديث status (open -> covered) لما تتغطى كل الحصص
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ===================== substituteCoverage (تغطية الحصص) =====================
    // جدول يومي استثنائي — سجل تعيين معلم بديل لحصة معيّنة، بدون أي تعديل على timetables الأصلي
    match /substituteCoverage/{coverageId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ===================== studentInterventions (خطط تدخل الطلاب) =====================
    // إدارة بس تقرأ/تكتب — بيانات حساسة (سبب إنذار، ملاحظات متابعة)، ما إلها داعي تنكشف لغير الإدارة
    match /studentInterventions/{interventionId} {
      allow read: if isAdmin() && sameSchool(resource.data.schoolId);
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.createdByUid == request.auth.uid && request.resource.data.status == 'open';
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if false;
    }

    // ===================== examPeriods (فترات الاختبارات) =====================
    // draft: الإدارة بس بتشوفها وقت البناء. published/locked: يصير يشوفها كل المدرسة
    // (نفس منطق timetables — جدول مو حساس، بدون تقييد بالشعبة/الدور).
    match /examPeriods/{periodId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId) && (isAdmin() || resource.data.status in ['published', 'locked']);
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId();
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if false;
    }

    // ===================== examSlots (حصص الاختبار الفردية) =====================
    // مادة + شعبة + تاريخ/وقت + قاعة + مراقب — القراءة مربوطة بحالة الفترة الأم (examPeriods)
    match /examSlots/{slotId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId) && (
        isAdmin() || get(/databases/$(database)/documents/examPeriods/$(resource.data.periodId)).data.status in ['published', 'locked']
      );
      allow create: if isAdmin() && request.resource.data.schoolId == mySchoolId();
      allow update: if isAdmin() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isAdmin() && sameSchool(resource.data.schoolId);
    }

    // ===================== questionBank (بنك الأسئلة) =====================
    // القراءة للإدارة/المعلمين بس (مو للطلاب — بيسرّب إجابات صحيحة). الكتابة على محتوى السؤال
    // مقيّدة بمعلم المادة، بس تحديث timesUsed/timesCorrect مسموح لأي حدا بنفس المدرسة لأنه
    // بينكتب من جلسة الطالب وقت حل اختبار مبني من سؤال بالبنك (إحصائية مجهّلة، مو حساسة)
    match /questionBank/{qId} {
      allow read: if isSignedIn() && sameSchool(resource.data.schoolId) && (isAdmin() || isInstructor());
      allow create: if isSignedIn() && request.resource.data.schoolId == mySchoolId()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || teachesSubject(request.resource.data.subjectId));
      allow update: if isSignedIn() && sameSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (
        (isAdmin() || teachesSubject(resource.data.subjectId))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed', 'timesCorrect'])
      );
      allow delete: if isSignedIn() && sameSchool(resource.data.schoolId) && (isAdmin() || teachesSubject(resource.data.subjectId));
    }

    // ===================== platformAdmins (صاحب المنصة) =====================
    // ما بينشأ ولا يتعدّل ولا يُحذف من المتصفح إطلاقًا — بس عبر سكربت Admin SDK
    match /platformAdmins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ===================== platformStats (لوحة صاحب المنصة) =====================
    // بيانات مجمّعة/إحصائية بس (عدد مستخدمين، آخر نشاط) — كل مدرسة بتكتب سجلها هي (admin trigger)،
    // صاحب المنصة يقرأها كلها. ما في أي بيانات طالب فردية هون إطلاقًا.
    match /platformStats/{schoolId} {
      allow read: if isPlatformAdmin() || (isAdmin() && sameSchool(schoolId));
      allow create, update: if isAdmin() && sameSchool(schoolId)
        && request.resource.data.keys().hasAll(['schoolName', 'studentCount', 'instructorCount', 'parentCount', 'updatedAt']);
      allow delete: if false;
    }

    // كل شي مو مذكور فوق ممنوع تلقائياً (سلوك Firestore الافتراضي أصلاً)
  }
}
